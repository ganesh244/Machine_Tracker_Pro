# Explicitly true keeps the offline browser demo; false enables MongoDB accounts.
VITE_LOCAL_DEMO=false
# Server-only values. Never prefix secrets with VITE_.
MONGODB_URI=mongodb+srv://farmmech_user:<password>@<farmmech-cluster>/farmmech?retryWrites=true&w=majority
MONGODB_DATABASE=farmmech
# Pin the separate FarmMech cluster; production refuses other hosts.
MONGODB_CLUSTER_HOST=<farmmech-cluster>.mongodb.net
APP_ORIGIN=https://farmmech-machine-tracker.vercel.app
# One-time first-admin setup code. Remove after first Admin has registered.
ADMIN_SETUP_TOKEN=<long-random-setup-code>
